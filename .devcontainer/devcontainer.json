{
    "name": "C++ OS Environment",
    "image": "mcr.microsoft.com/devcontainers/cpp:1-ubuntu-22.04",
    "customizations": {
        "vscode": {
            "settings": {
                "github.copilot.enable": {
                    "*": false
                },
                "editor.inlineSuggest.enabled": false,
                "chat.disableAIFeatures": true
            },
            "extensions": [
                "ms-vscode.cpptools",
                "ms-vscode.cpptools-extension-pack"
            ]
        }
    }
}
